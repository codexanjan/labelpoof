{
  "name": "labelproof",
  "version": "3.0.1",
  "private": true,
  "description": "Evidence-backed packaged-food label review dashboard with browser OCR, image evidence and versioned reports.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "test:buttons": "node tests/buttons.mjs",
    "test:ocr": "node tests/ocr-browser.mjs",
    "test:ocr-errors": "node tests/ocr-errors.mjs",
    "test:deployment": "node tests/deployment.mjs",
    "test:upgrades": "node tests/upgrades.mjs",
    "test:storage": "node tests/storage-upgrade.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@zxing/browser": "0.2.1",
    "jspdf": "4.2.1",
    "lucide": "0.468.0",
    "tesseract.js": "6.0.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "prettier": "3.9.9"
  }
}
